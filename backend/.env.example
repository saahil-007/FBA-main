# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# CORS Configuration (MANDATORY)
# Comma-separated list of allowed origins (No trailing slash)
# Example: http://localhost:5173,https://your-app.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# # Model Configuration (HuggingFace)
HF_REPO=public-data/insightface
DET_MODEL_FILE=models/buffalo_l/det_10g.onnx
REC_MODEL_FILE=models/buffalo_l/w600k_r50.onnx

# Application Settings
RECOGNITION_THRESHOLD=0.45
PORT=8000
